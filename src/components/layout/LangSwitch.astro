---
/**
 * 语言切换链接，指向当前页面的另一种语言版本；没有对应版本时（例如 404）指向另一种语言的首页。
 * 点击时把所选语言保存为访客的语言偏好，BaseLayout 据此跳转；指向同一页面时还会带上当前网址的查询参数和锚点。
 * 宽屏下显示简写（EN / 中）；导航折叠为菜单面板后显示带图标的完整名称。
 */
import { pages } from '@/config/site';
import { getLang, htmlLang, localizePath, otherLang, translator } from '@/i18n';
import { ui } from '@/i18n/ui';
import Icon from '@/components/ui/Icon.astro';

interface Props {
  /** 当前页面另一种语言版本的路径，没有对应版本时为 null */
  alternate: string | null;
}

const { alternate } = Astro.props;
const lang = getLang(Astro.url);
const t = translator(lang);
const target = htmlLang[otherLang(lang)];
---

<a
  class="lang-switch"
  href={alternate ?? localizePath(pages.home, otherLang(lang))}
  data-same-page={alternate ? '' : undefined}
  hreflang={target}
  lang={target}
  aria-label={t(ui.lang.switchLabel)}
  data-chamfer="notch-sm"
>
  <Icon name="global-line" class="icon" />
  <span class="short">{t(ui.lang.switchShort)}</span>
  <span class="full">{t(ui.lang.switchName)}</span>
</a>

<script>
  const link = document.querySelector<HTMLAnchorElement>('.lang-switch')!;
  link.addEventListener('click', () => {
    // 同一页面的两种语言版本筛选参数和锚点相同，切换时带上，访客停在同样的筛选结果和位置
    if (link.hasAttribute('data-same-page')) {
      link.search = location.search;
      link.hash = location.hash;
    }
    // 取值与 <html lang> 相同，为 zh-CN 或 en，与旧网站保存的偏好通用
    try {
      localStorage.setItem('lang', link.hreflang);
    } catch {}
  });
</script>

<style>
  .lang-switch {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    min-width: 40px;
    height: 40px;
    color: var(--color-text-secondary);
    font-family: var(--font-label);
    font-size: 13px;
    font-weight: 500;
    letter-spacing: 1px;
    transition: color var(--duration-hover);
  }

  .lang-switch:hover {
    color: var(--color-accent-text);
  }

  .lang-switch .icon,
  .full {
    display: none;
  }

  @media (max-width: 900px) {
    .lang-switch {
      --chamfer-stroke: var(--color-line-strong);
      height: auto;
      padding: 13px 19px;
      font-family: var(--font-body);
      font-size: var(--text-small);
      letter-spacing: 0;
    }

    .lang-switch .icon {
      display: inline-block;
      font-size: 18px;
    }

    .full {
      display: inline;
    }

    .short {
      display: none;
    }
  }
</style>

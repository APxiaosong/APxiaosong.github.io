---
/**
 * 创意工坊页的一个作者章节：背景上有巨型序号，标题行是描边序号、名称、副名和简介，右侧是链接，
 * 作品放在默认插槽中。tone 为 base 时背景序号在右侧，为 alt 时在左侧，相邻章节交替使用。
 */
import '@fontsource-variable/noto-serif-sc';
import type { HTMLAttributes } from 'astro/types';
import { getLang, translator } from '@/i18n';
import ArrowLink from '@/components/ui/ArrowLink.astro';
import Badge from '@/components/ui/Badge.astro';
import Section from '@/components/ui/Section.astro';
import Watermark from '@/components/ui/Watermark.astro';

interface Props extends HTMLAttributes<'section'> {
  index: string;
  name: string;
  /** 名称下方的斜体副名，通常是另一种语言的名称 */
  handle?: string;
  /** 名称下方的简介，各段之间用「·」分隔，换行优先发生在分隔处 */
  meta: string[];
  official?: boolean;
  link: { href: string; label: string; external?: boolean };
  tone: 'base' | 'alt';
}

const { index, name, handle, meta, official = false, link, tone, class: className, ...rest } = Astro.props;
const t = translator(getLang(Astro.url));
---

<Section tone={tone} space="md" divider class:list={['chapter', className]} {...rest}>
  <Watermark text={index} class:list={['ghost', tone === 'base' ? 'right' : 'left']} />
  <div class="head" data-reveal>
    <div class="identity">
      <span class="index" aria-hidden="true">{index}</span>
      <div>
        <div class="name-row">
          <h2 class="name">{name}</h2>
          {official && <Badge>{t({ zh: '官方', en: 'Official' })}</Badge>}
        </div>
        {handle && <p class="handle text-accent">{handle}</p>}
        <p class="meta">{meta.map((part) => <span>{part}</span>)}</p>
      </div>
    </div>
    <ArrowLink href={link.href} external={link.external} underline class="link">{link.label}</ArrowLink>
  </div>
  <div class="body" data-reveal style="--reveal-delay: 120ms">
    <slot />
  </div>
</Section>

<style>
  .chapter {
    overflow: hidden;
  }

  .chapter .ghost {
    top: 30px;
    font-size: clamp(160px, 26vw, 420px);
    line-height: 0.7;
  }

  .chapter .right {
    right: -2%;
  }

  .chapter .left {
    right: auto;
    left: -2%;
  }

  .head,
  .body {
    position: relative;
  }

  .head {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 24px 30px;
    margin-bottom: 36px;
    padding-bottom: 30px;
    border-bottom: 1px solid var(--color-line-strong);
  }

  .identity {
    display: flex;
    align-items: flex-start;
    gap: 26px;
  }

  .index {
    flex: none;
    font-family: var(--font-label);
    font-size: clamp(40px, 5vw, 72px);
    font-weight: 700;
    line-height: 0.8;
    color: transparent;
    -webkit-text-stroke: 1.5px var(--color-accent);
  }

  .name-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px;
  }

  .name {
    font-family: var(--font-serif);
    font-size: clamp(28px, 3.6vw, 48px);
    font-weight: 600;
    line-height: 1;
  }

  .handle {
    margin-top: 6px;
    font-size: clamp(17px, 2vw, 24px);
  }

  .meta {
    margin-top: 8px;
    font-size: var(--text-small);
    font-weight: 300;
    color: var(--color-text-muted);
  }

  /* 每段作为整体换行，分隔点留在上一行末尾 */
  .meta span {
    display: inline-block;
  }

  .meta span:not(:last-child)::after {
    content: '·';
    margin-inline: 0.6em;
  }

  .link {
    flex: none;
  }

  @media (max-width: 600px) {
    .identity {
      gap: 16px;
    }

    .head {
      margin-bottom: 28px;
      padding-bottom: 24px;
    }
  }
</style>

---
/** 创意工坊页官方章节中的传奇模组介绍：封面、简介、版本和订阅数据，以及订阅按钮。数据来自 mod.ts。 */
import type { HTMLAttributes } from 'astro/types';
import { Image } from 'astro:assets';
import cover from '@/assets/images/mod-cover.jpg';
import { links } from '@/config/site';
import { getMod } from '@/data/mod';
import { getLang, translator } from '@/i18n';
import { formatDate, formatNumber } from '@/i18n/format';
import { ui } from '@/i18n/ui';
import Button from '@/components/ui/Button.astro';

type Props = HTMLAttributes<'div'>;

const { class: className, ...rest } = Astro.props;
const lang = getLang(Astro.url);
const t = translator(lang);
const mod = getMod();

const copy = {
  lead: {
    zh: '由传奇建造队开发和维护的综合性模组，在 Steam 创意工坊发布。订阅之后，Steam 会自动下载并保持更新。',
    en: 'A comprehensive mod developed and maintained by Legend Build Team, published on the Steam Workshop. Once you subscribe, Steam downloads it and keeps it up to date.',
  },
};

const specs = [
  { label: { zh: '当前版本', en: 'Version' }, value: mod.version },
  { label: { zh: '物品数量', en: 'Items' }, value: formatNumber(mod.itemCount) },
  { label: { zh: '订阅人数', en: 'Subscribers' }, value: formatNumber(mod.subscriptions) },
  { label: { zh: '最近更新', en: 'Last Updated' }, value: formatDate(mod.updatedAt, lang) },
];
---

<div class:list={['feature', className]} {...rest}>
  <div class="media" data-chamfer="frame-lg">
    <Image src={cover} alt={t(ui.mod.name)} widths={[640, 960, 1280]} sizes="(max-width: 900px) 100vw, 50vw" />
  </div>
  <div class="text">
    <p class="kicker text-label">{mod.name}</p>
    <h3 class="title">{t(ui.mod.name)}</h3>
    <p class="text-body">{t(copy.lead)}</p>
    <dl class="specs">
      {
        specs.map((spec) => (
          <div class="spec">
            <dt class="text-label">{t(spec.label)}</dt>
            <dd>{spec.value}</dd>
          </div>
        ))
      }
    </dl>
    <Button href={links.modWorkshop} external>{t(ui.mod.subscribe)}</Button>
  </div>
</div>

<style>
  .feature {
    display: grid;
    grid-template-columns: 1.05fr 0.95fr;
    align-items: center;
    gap: clamp(32px, 4vw, 60px);
  }

  .media {
    --chamfer-stroke: var(--color-line);
  }

  .media :global(img) {
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 9;
    object-fit: cover;
  }

  .text {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  .kicker {
    color: var(--color-accent-text);
  }

  .title {
    margin: 10px 0 16px;
    font-size: var(--text-h3);
    font-weight: 700;
  }

  .specs {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 20px 30px;
    align-self: stretch;
    margin: 28px 0 34px;
  }

  .spec {
    padding-top: 14px;
    border-top: 1px solid var(--color-line);
  }

  dt {
    color: var(--color-text-muted);
  }

  dd {
    margin-top: 6px;
    font-family: var(--font-label);
    font-size: clamp(20px, 2vw, 26px);
    font-weight: 600;
    line-height: 1.2;
  }

  @media (max-width: 900px) {
    .feature {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>

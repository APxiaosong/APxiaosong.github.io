---
/**
 * 分组标题：一段金色短线后接 Oswald 大写金色文字，用于常见问题和教程库中的分组。
 */
import type { HTMLAttributes } from 'astro/types';

type Props = HTMLAttributes<'h2'>;

const { class: className, ...rest } = Astro.props;
---

<h2 class:list={['group-heading', className]} {...rest}><slot /></h2>

<style>
  .group-heading {
    display: flex;
    align-items: center;
    gap: 14px;
    margin-bottom: 30px;
    font-family: var(--font-label);
    font-size: 15px;
    font-weight: 600;
    line-height: 1.3;
    letter-spacing: 3px;
    text-transform: uppercase;
    color: var(--color-accent-text);
  }

  .group-heading::before {
    content: '';
    flex: none;
    width: 30px;
    height: 2px;
    background: var(--color-accent);
  }
</style>

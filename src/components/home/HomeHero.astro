---
/**
 * 首页首屏，锚点 #home。整屏海报图缓慢放大，左侧和底部压暗，标题和按钮靠左居中。
 * 「观看预告」在新窗口打开视频：中文版为 B 站，英文版为 YouTube。
 */
import { Image } from 'astro:assets';
import poster from '@/assets/images/scene-creative.png';
import { links } from '@/config/site';
import { getLang, translator } from '@/i18n';
import { ui } from '@/i18n/ui';
import Button from '@/components/ui/Button.astro';
import ButtonGroup from '@/components/ui/ButtonGroup.astro';
import Tag from '@/components/ui/Tag.astro';

const t = translator(getLang(Astro.url));

const copy = {
  lead: {
    zh: '为《废品机械师》玩家提供丰富的模组内容与建造工具。我们是这款游戏的中国玩家社区，也是传奇模组的开发团队。',
    en: 'Mod content and building tools for Scrap Mechanic players. We are a Chinese Scrap Mechanic community and the team behind the New Legend Mod.',
  },
  explore: { zh: '探索传奇模组', en: 'Explore the Mod' },
  trailer: { zh: '观看预告', en: 'Watch Trailer' },
};
---

<header id="home" class="hero" data-theme="dark">
  <div class="media" aria-hidden="true">
    <Image src={poster} alt="" widths={[768, 1280, 1920]} sizes="100vw" loading="eager" fetchpriority="high" />
  </div>
  <div class="shade" aria-hidden="true"></div>

  <div class="container content">
    <Tag size="lg" dot>New Legend Mod</Tag>
    <h1 class="title">{t(ui.site.name)}</h1>
    <p class="subtitle text-accent">{t(ui.site.subtitle)}</p>
    <p class="lead">{t(copy.lead)}</p>
    <ButtonGroup class="actions">
      <Button href="#mod">{t(copy.explore)}</Button>
      <Button href={t(links.trailer)} variant="ghost" iconBefore="play-fill" external>{t(copy.trailer)}</Button>
    </ButtonGroup>
  </div>

  <span class="caption" aria-hidden="true">Scrap Mechanic // {new Date().getFullYear()}</span>
</header>

<style>
  .hero {
    position: relative;
    display: flex;
    align-items: center;
    min-height: max(700px, 100svh);
    padding-block: calc(var(--nav-height) + 40px) 80px;
    overflow: hidden;
    background: var(--color-bg);
    color: var(--color-text);
  }

  .media {
    position: absolute;
    inset: 0;
    overflow: hidden;
    animation: in-fade 1.8s ease both;
  }

  .media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: right center;
    transform-origin: right center;
    animation: hero-drift 30s ease-out both;
  }

  /* 海报左上角自带游戏 Logo，压暗这个角落，不让它和标签、标题挤在一起 */
  .media::after {
    content: '';
    position: absolute;
    inset: 0;
    background: radial-gradient(ellipse 70% 62% at 0 0, var(--color-bg) 55%, transparent);
  }

  @keyframes hero-drift {
    from {
      transform: scale(1.02);
    }
    to {
      transform: scale(1.12);
    }
  }

  /* 左侧压暗、顶部和底部渐隐，再叠一层 120px 间距的竖向细线 */
  .shade {
    position: absolute;
    inset: 0;
    background:
      repeating-linear-gradient(
        90deg,
        transparent 0 119px,
        color-mix(in srgb, var(--color-text) 2.5%, transparent) 119px 120px
      ),
      linear-gradient(
        180deg,
        color-mix(in srgb, var(--color-bg) 60%, transparent),
        transparent 30% 50%,
        color-mix(in srgb, var(--color-bg) 85%, transparent) 88%,
        var(--color-bg)
      ),
      linear-gradient(
        90deg,
        color-mix(in srgb, var(--color-bg) 92%, transparent),
        color-mix(in srgb, var(--color-bg) 40%, transparent) 55%,
        color-mix(in srgb, var(--color-bg) 20%, transparent)
      );
  }

  .content {
    position: relative;
    animation: in-rise 1.1s var(--ease-out) both;
  }

  .title {
    margin-top: 26px;
    font-size: var(--text-hero);
    font-weight: 900;
    line-height: 0.92;
    letter-spacing: -1px;
    text-shadow: 0 6px 40px rgb(0 0 0 / 0.5);
  }

  .title:lang(en) {
    font-size: clamp(48px, 8.4vw, 124px);
    line-height: 1;
  }

  .subtitle {
    margin-top: 6px;
    font-size: clamp(22px, 3vw, 40px);
    letter-spacing: 1px;
  }

  .lead {
    max-width: 560px;
    margin-top: 26px;
    font-size: var(--text-lead);
    font-weight: 300;
    line-height: 1.9;
    color: var(--color-text-secondary);
  }

  .actions {
    margin-top: 38px;
  }

  .caption {
    position: absolute;
    right: var(--gutter);
    bottom: 28px;
    font-family: var(--font-label);
    font-size: 11px;
    letter-spacing: 4px;
    text-transform: uppercase;
    color: var(--color-text-muted);
    animation: in-fade 2s ease 1s both;
  }

  @media (max-width: 600px) {
    .hero {
      align-items: flex-end;
      padding-bottom: 72px;
    }

    .shade {
      background:
        linear-gradient(
          180deg,
          color-mix(in srgb, var(--color-bg) 30%, transparent),
          color-mix(in srgb, var(--color-bg) 55%, transparent) 40%,
          color-mix(in srgb, var(--color-bg) 92%, transparent) 78%,
          var(--color-bg)
        );
    }
  }
</style>

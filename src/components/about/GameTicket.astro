---
/**
 * 废品机械师页「05 获取游戏」：仿入场券的购买入口。
 * 左侧票面介绍游戏，右侧票根显示国区售价和商店链接；上下边缘是邮票齿孔，
 * 票面与票根之间是虚线、打孔和一枚骑在虚线上的圆章。手机上票根移到票面下方。
 */
import { links } from '@/config/site';
import { getLang, translator } from '@/i18n';
import { ui } from '@/i18n/ui';
import Badge from '@/components/ui/Badge.astro';
import Button from '@/components/ui/Button.astro';
import Section from '@/components/ui/Section.astro';
import SectionHeading from '@/components/ui/SectionHeading.astro';
import Watermark from '@/components/ui/Watermark.astro';

const t = translator(getLang(Astro.url));

const appId = '387990';
// 国区标准售价，单位为人民币元
const price = 109;

const copy = {
  tag: { zh: '获取游戏 / Get the Game', en: 'Get the Game' },
  // 「开」「始」之间隔着不占宽度的连接符 \u2060，标题换行时不会把这个词拆开
  title: { zh: '在 Steam 开\u2060始你的建造', en: 'Start building on Steam' },
  text: {
    zh: '传奇模组需要在本体游戏中运行。若你还未拥有《废品机械师》，可前往 Steam 商店了解与购买，随后订阅传奇模组，即可开始属于你的建造旅程。',
    en: "The New Legend Mod runs inside the base game. If you don't own Scrap Mechanic yet, you can find it on the Steam store. Once you have the game, subscribe to the Mod and start building.",
  },
  features: {
    zh: ['1.0 正式版', '创造模式', '生存模式', '挑战模式', '多人协作'],
    en: ['Version 1.0', 'Creative', 'Survival', 'Challenge', 'Co-op'],
  },
  priceLabel: { zh: '参考售价 · Price', en: 'Price' },
  currency: { zh: '人民币 · CNY', en: 'CNY · China region' },
  store: { zh: '前往 Steam 商店', en: 'Visit Steam Store' },
  footnote: {
    zh: `* 1.0 正式版发布后，国区标准售价由 ¥68 调整为 ¥${price}。售价以 Steam 商店实际页面为准，促销期间可能有所不同。`,
    en: `* With the 1.0 release, the standard price in the China region changed from ¥68 to ¥${price}. Prices differ by region and during sales; the Steam store page shows the current price.`,
  },
};
---

<Section space="lg" divider>
  <SectionHeading index="05" tag={t(copy.tag)} title={t(copy.title)} data-reveal />

  <div class="ticket" data-chamfer="ticket" data-reveal>
    <Watermark text={appId} />

    <div class="face">
      <div class="meta" aria-hidden="true">
        <span class="app">Steam · App {appId}</span>
        <span class="serial">No. SM-{appId}-NLM</span>
      </div>
      <h3 class="name">{t(ui.nav.game)}</h3>
      <p class="subtitle text-accent">{t(ui.game.subtitle)}</p>
      <p class="text text-body">{t(copy.text)}</p>
      <ul class="features">
        {
          t(copy.features).map((feature) => (
            <li>
              <Badge tone="outline">{feature}</Badge>
            </li>
          ))
        }
      </ul>
      <div class="stamp" aria-hidden="true">
        <span>Admit</span>
        <span>One</span>
        <small>New Legend</small>
      </div>
    </div>

    <div class="stub">
      <span class="price-label">{t(copy.priceLabel)}</span>
      <p class="price">
        <span class="currency-sign">¥</span>
        <span class="amount">{price}</span>
      </p>
      <span class="currency">{t(copy.currency)}</span>
      <Button href={links.gameStore} external>{t(copy.store)}</Button>
      <div class="barcode" aria-hidden="true"></div>
      <span class="barcode-text" aria-hidden="true">SM · {appId} · NLM</span>
    </div>
  </div>

  <p class="footnote" data-reveal>{t(copy.footnote)}</p>
</Section>

<style>
  .ticket {
    --hole: var(--color-bg);
    --chamfer-stroke: var(--color-accent-line);
    position: relative;
    display: grid;
    grid-template-columns: 1.6fr 1fr;
    overflow: hidden;
    background:
      repeating-linear-gradient(
        90deg,
        transparent 0 89px,
        color-mix(in srgb, var(--color-text) 2%, transparent) 89px 90px
      ),
      var(--color-bg-alt);
  }

  /* 上下边缘的邮票齿孔：上下各一排与页面同色的圆，各露出一半，盖住描边 */
  .ticket::before {
    --perforation: radial-gradient(circle 6px at 10px 7px, var(--hole) 6px, transparent 6.5px);
    content: '';
    position: absolute;
    top: -7px;
    right: 22px;
    bottom: -7px;
    left: 22px;
    z-index: 3;
    background:
      var(--perforation) left top / 20px 14px repeat-x,
      var(--perforation) left bottom / 20px 14px repeat-x;
    pointer-events: none;
  }

  .face {
    position: relative;
    padding: clamp(36px, 5vw, 68px);
    border-right: 2px dashed var(--color-accent-line);
  }

  .meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    margin-bottom: 22px;
    font-family: var(--font-label);
    text-transform: uppercase;
  }

  .app {
    display: flex;
    align-items: center;
    gap: 12px;
    font-size: var(--text-label);
    letter-spacing: 4px;
    color: var(--color-accent-text);
  }

  .app::before {
    content: '';
    width: 34px;
    height: 2px;
    background: var(--color-accent);
  }

  .serial {
    font-size: 11px;
    letter-spacing: 2px;
    color: var(--color-text-faint);
  }

  .name {
    font-size: clamp(28px, 3.6vw, 48px);
    line-height: 1.05;
  }

  .subtitle {
    margin-top: 4px;
    font-size: clamp(16px, 2vw, 22px);
    color: var(--color-text-muted);
  }

  .text {
    max-width: 460px;
    margin-top: 22px;
  }

  .features {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 26px;
  }

  /* 骑在虚线上的圆章，一半压在票根上 */
  .stamp {
    position: absolute;
    right: -46px;
    bottom: 34px;
    z-index: 2;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    width: 104px;
    height: 104px;
    border: 2px solid var(--color-accent-line);
    border-radius: 50%;
    background: color-mix(in srgb, var(--color-bg-alt) 40%, transparent);
    font-family: var(--font-label);
    font-weight: 700;
    line-height: 1;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: var(--color-accent-text);
    opacity: 0.8;
    transform: rotate(-14deg);
  }

  .stamp span {
    font-size: 15px;
  }

  .stamp span + span {
    margin-top: 2px;
  }

  .stamp small {
    margin-top: 5px;
    font-size: 8px;
    font-weight: 400;
  }

  .stub {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: clamp(36px, 4vw, 52px);
    background: var(--color-accent-tint);
    text-align: center;
  }

  /* 虚线两端的打孔，盖住描边 */
  .stub::before,
  .stub::after {
    content: '';
    position: absolute;
    left: -13px;
    z-index: 2;
    width: 26px;
    height: 26px;
    border-radius: 50%;
    background: var(--hole);
  }

  .stub::before {
    top: -13px;
  }

  .stub::after {
    bottom: -13px;
  }

  .price-label {
    font-family: var(--font-label);
    font-size: var(--text-label);
    letter-spacing: 3px;
    text-transform: uppercase;
    color: var(--color-text-muted);
  }

  .price {
    display: flex;
    align-items: baseline;
    gap: 5px;
    margin: 10px 0 4px;
    font-family: var(--font-label);
    color: var(--color-accent-text);
  }

  .currency-sign {
    font-size: 30px;
    font-weight: 600;
  }

  .amount {
    font-size: 78px;
    font-weight: 700;
    line-height: 0.85;
  }

  .currency {
    margin-bottom: 26px;
    font-size: 13px;
    color: var(--color-text-muted);
  }

  .barcode {
    width: 140px;
    height: 38px;
    margin-top: 26px;
    background: repeating-linear-gradient(
      90deg,
      var(--color-text-muted) 0 2px,
      transparent 2px 4px,
      var(--color-text-muted) 4px 5px,
      transparent 5px 8px,
      var(--color-text-muted) 8px 11px,
      transparent 11px 13px
    );
    opacity: 0.55;
  }

  .barcode-text {
    margin-top: 8px;
    font-family: var(--font-label);
    font-size: 10px;
    letter-spacing: 3px;
    text-transform: uppercase;
    color: var(--color-text-faint);
  }

  .footnote {
    margin-top: 18px;
    font-size: 13px;
    font-weight: 300;
    line-height: 1.8;
    color: var(--color-text-muted);
  }

  /* 票根移到票面下方，虚线改为横向，打孔和圆章随之移到横线两端和右侧 */
  @media (max-width: 900px) {
    .ticket {
      grid-template-columns: minmax(0, 1fr);
    }

    .face {
      padding-bottom: 72px;
      border-right: 0;
      border-bottom: 2px dashed var(--color-accent-line);
    }

    .stamp {
      right: 28px;
      bottom: -52px;
    }

    .stub {
      padding-top: 64px;
    }

    .stub::after {
      top: -13px;
      right: -13px;
      bottom: auto;
      left: auto;
    }
  }

  @media (max-width: 600px) {
    .face {
      padding: 40px 24px 72px;
    }

    .stamp {
      right: 16px;
      width: 88px;
      height: 88px;
    }

    .stamp span {
      font-size: 13px;
    }
  }
</style>

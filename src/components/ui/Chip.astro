---
/**
 * 切角小标签，用于零件分类、关键词和筛选按钮。
 * 传入 href 时渲染为链接；传入 pressed 时渲染为筛选按钮（Oswald 大写字，未选中时透明底），
 * 选中态由 aria-pressed 决定，脚本切换这个属性即可改变外观。
 * highlight 让静态标签显示为金底，用于需要突出的那一项。
 */
import type { HTMLAttributes } from 'astro/types';

interface Props extends HTMLAttributes<'span'> {
  href?: string;
  pressed?: boolean;
  highlight?: boolean;
}

const { href, pressed, highlight = false, class: className, ...rest } = Astro.props;
const classes = ['chip', { highlight, interactive: href || pressed !== undefined }, className];
---

{
  href ? (
    <a class:list={classes} href={href} data-chamfer="notch-sm" {...rest}>
      <slot />
    </a>
  ) : pressed !== undefined ? (
    <button class:list={classes} type="button" aria-pressed={pressed ? 'true' : 'false'} data-chamfer="notch-sm" {...rest}>
      <slot />
    </button>
  ) : (
    <span class:list={classes} data-chamfer="notch-sm" {...rest}>
      <slot />
    </span>
  )
}

<style>
  .chip {
    --chamfer-stroke: var(--color-line-strong);
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 11px 19px;
    background: var(--color-bg);
    color: var(--color-text-secondary);
    font-size: var(--text-small);
    line-height: 1.4;
    white-space: nowrap;
    transition:
      color var(--duration-hover),
      background-color var(--duration-hover);
  }

  .interactive:hover {
    --chamfer-stroke: var(--color-accent-line);
    color: var(--color-accent-text);
  }

  .chip[aria-pressed] {
    padding: 12px 23px;
    background: transparent;
    font-family: var(--font-label);
    font-size: 13px;
    letter-spacing: 1px;
    text-transform: uppercase;
  }

  /* 焦点框画在 chip 内侧的金底上，改用深色 */
  .chip.highlight,
  .chip[aria-pressed='true'] {
    --chamfer-stroke: var(--color-accent);
    --color-focus: var(--color-on-accent);
    background: var(--color-accent);
    color: var(--color-on-accent);
    font-weight: 700;
  }

  @media (max-width: 600px) {
    .chip[aria-pressed] {
      padding: 10px 15px;
    }
  }
</style>

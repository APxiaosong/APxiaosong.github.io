---
/**
 * 带大号序号的介绍块：左侧是金色大号序号和一个小方块，右侧放标签、标题和正文。
 * 用于页面第一段介绍，例如首页「01 关于传奇建造队」。
 */
import type { HTMLAttributes } from 'astro/types';

interface Props extends HTMLAttributes<'div'> {
  index: string;
}

const { index, class: className, ...rest } = Astro.props;
---

<div class:list={['intro', className]} {...rest}>
  <div class="index" aria-hidden="true">{index}</div>
  <div class="body"><slot /></div>
</div>

<style>
  .intro {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: 56px;
    align-items: start;
  }

  .index {
    position: relative;
    font-family: var(--font-label);
    font-size: clamp(78px, 12vw, 180px);
    font-weight: 700;
    line-height: 0.8;
    color: var(--color-accent);
  }

  .index::after {
    content: '';
    position: absolute;
    top: 8px;
    right: -12px;
    width: 8px;
    height: 8px;
    background: var(--color-accent);
  }

  @media (max-width: 600px) {
    .intro {
      grid-template-columns: minmax(0, 1fr);
      gap: 28px;
    }

    .index {
      justify-self: start;
    }
  }
</style>

---
/**
 * 小号标签，用于卡片图片上的分类、来源、难度等简短信息。
 * tone：solid 金底直角；outline 金色描边，切去左上和右下两角；muted 半透明深底直角（叠在图片上时使用）。
 */
import type { HTMLAttributes } from 'astro/types';

interface Props extends HTMLAttributes<'span'> {
  tone?: 'solid' | 'outline' | 'muted';
}

const { tone = 'solid', class: className, ...rest } = Astro.props;
---

<span class:list={['badge', tone, className]} data-chamfer={tone === 'outline' ? 'notch-sm' : undefined} {...rest}>
  <slot />
</span>

<style>
  .badge {
    display: inline-block;
    padding: 4px 10px;
    font-family: var(--font-label);
    font-size: 11px;
    font-weight: 500;
    line-height: 1.3;
    letter-spacing: 1px;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .solid {
    background: var(--color-accent);
    color: var(--color-on-accent);
  }

  /* 描边画在内侧，内边距多留出描边的宽度 */
  .outline {
    --chamfer-stroke: var(--color-accent-line);
    padding: 5px 11px;
    color: var(--color-accent-text);
  }

  .muted {
    background: color-mix(in srgb, var(--color-bg) 82%, transparent);
    color: var(--color-text-secondary);
  }
</style>

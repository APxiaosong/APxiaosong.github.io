---
/**
 * 模组页的截图轮播：上方是大图，下方是缩略图条。点击大图在灯箱中查看原图，页面需要放置 Lightbox。
 * 区块在视口内时每 5 秒切换一张；鼠标悬停、键盘焦点在区块内时暂停，手动切换后不再自动播放，
 * 系统开启「减弱动态效果」时不自动播放。
 */
import Icon from '@/components/ui/Icon.astro';
import SectionHeading from '@/components/ui/SectionHeading.astro';
import { resizeImage } from '@/data/images';
import { getMod, type Screenshot } from '@/data/mod';
import { getLang, translator } from '@/i18n';

const t = translator(getLang(Astro.url));
const { screenshots } = getMod();

const copy = {
  tag: { zh: '模组预览 / Preview', en: 'Preview' },
  title: { zh: '来自游戏内的实拍', en: 'Straight from the game' },
  hint: { zh: '点击缩略图或箭头浏览', en: 'Use the thumbnails or arrows to browse' },
  carousel: { zh: '模组截图', en: 'Mod screenshots' },
  alt: { zh: '传奇模组游戏截图 {n}', en: 'New Legend Mod screenshot {n}' },
  open: { zh: '查看大图', en: 'View full size' },
  previous: { zh: '上一张', en: 'Previous screenshot' },
  next: { zh: '下一张', en: 'Next screenshot' },
};

const pad = (n: number) => String(n).padStart(2, '0');
const total = pad(screenshots.length);

// Steam 返回的图片不会超过原图宽度，候选宽度也以原图宽度为上限
const stageSrcset = (shot: Screenshot) =>
  [...[960, 1440, 1920].filter((w) => w < shot.width), shot.width]
    .map((w) => `${resizeImage(shot.image, w)} ${w}w`)
    .join(', ');

const slides = screenshots.map((shot, i) => ({
  shot,
  alt: t(copy.alt).replace('{n}', String(i + 1)),
  src: resizeImage(shot.image, Math.min(shot.width, 1440)),
  srcset: stageSrcset(shot),
}));
const first = slides[0];
---

<div class="screenshots" data-screenshots>
  <div class="head" data-reveal>
    <SectionHeading tag={t(copy.tag)} title={t(copy.title)} class="heading" />
    <p class="hint">
      <span class="hint-text text-note">{t(copy.hint)}</span>
      <span class="hint-count"><span data-counter>01</span> / {total}</span>
    </p>
  </div>

  <div data-reveal>
    <div class="stage" data-theme="dark" role="group" aria-roledescription="carousel" aria-label={t(copy.carousel)}>
      <a class="frame" href={first.shot.image} data-lightbox="mod-screenshots" data-frame>
        <img
          src={first.src}
          srcset={first.srcset}
          sizes="(max-width: 600px) calc(100vw - 40px), (max-width: 1400px) calc(100vw - 80px), 1320px"
          width={first.shot.width}
          height={first.shot.height}
          alt={first.alt}
          loading="lazy"
          decoding="async"
          data-image
        />
        <span class="open">
          {t(copy.open)}
          <Icon name="zoom-in-line" />
        </span>
      </a>
      <div class="shade" aria-hidden="true"></div>
      <p class="number" aria-hidden="true"><span data-counter>01</span><span class="total">/ {total}</span></p>
      <span class="side-label" aria-hidden="true">Preview</span>
      <button class="arrow previous" type="button" aria-label={t(copy.previous)} data-step="-1">
        <Icon name="arrow-left-s-fill" />
      </button>
      <button class="arrow next" type="button" aria-label={t(copy.next)} data-step="1">
        <Icon name="arrow-right-s-fill" />
      </button>
      <span class="progress" aria-hidden="true"></span>
    </div>

    <div class="rail" data-rail>
      {
        slides.map(({ shot, alt, src, srcset }, i) => (
          <button
            class="thumb"
            type="button"
            aria-label={alt}
            aria-current={i === 0 ? 'true' : undefined}
            data-index={i}
            data-src={src}
            data-srcset={srcset}
            data-full={shot.image}
            data-width={shot.width}
            data-height={shot.height}
          >
            <img src={resizeImage(shot.image, 208)} width="208" height="124" alt="" loading="lazy" decoding="async" />
          </button>
        ))
      }
    </div>
  </div>
</div>

<script>
  import { prefersReducedMotion } from '@/components/ui/motion';

  const root = document.querySelector<HTMLElement>('[data-screenshots]')!;
  const frame = root.querySelector<HTMLAnchorElement>('[data-frame]')!;
  const image = root.querySelector<HTMLImageElement>('[data-image]')!;
  const rail = root.querySelector<HTMLElement>('[data-rail]')!;
  const thumbs = Array.from(rail.querySelectorAll<HTMLButtonElement>('[data-index]'));
  const counters = root.querySelectorAll('[data-counter]');
  const INTERVAL = 5000;

  let index = 0;
  let timer = 0;
  let inView = false;
  let paused = false;
  let autoplay = !prefersReducedMotion();

  function restartTimer() {
    clearTimeout(timer);
    if (autoplay && inView && !paused) timer = window.setTimeout(() => show(index + 1), INTERVAL);
  }

  async function show(position: number) {
    index = (position + thumbs.length) % thumbs.length;
    const thumb = thumbs[index];
    const label = String(index + 1).padStart(2, '0');

    for (const item of thumbs) {
      if (item === thumb) item.setAttribute('aria-current', 'true');
      else item.removeAttribute('aria-current');
    }
    for (const counter of counters) counter.textContent = label;
    root.style.setProperty('--progress', `${((index + 1) / thumbs.length) * 100}%`);
    rail.scrollTo({
      left: thumb.offsetLeft - (rail.clientWidth - thumb.offsetWidth) / 2,
      behavior: prefersReducedMotion() ? 'auto' : 'smooth',
    });
    restartTimer();

    // 新图片解码完成后再替换，避免切换时出现空白
    const { src, srcset, full, width, height } = thumb.dataset;
    const loader = new Image();
    loader.sizes = image.sizes;
    loader.srcset = srcset!;
    loader.src = src!;
    await loader.decode().catch(() => {});
    if (thumbs[index] !== thumb) return;

    image.srcset = srcset!;
    image.src = src!;
    image.width = Number(width);
    image.height = Number(height);
    image.alt = thumb.ariaLabel ?? '';
    frame.href = full!;
    if (!prefersReducedMotion()) image.animate({ opacity: [0, 1] }, { duration: 650, easing: 'ease' });
  }

  function stepManually(position: number) {
    autoplay = false;
    show(position);
  }

  root.addEventListener('click', (event) => {
    const target = event.target as Element;
    const arrow = target.closest<HTMLElement>('[data-step]');
    const thumb = target.closest<HTMLElement>('[data-index]');
    if (arrow) stepManually(index + Number(arrow.dataset.step));
    else if (thumb) stepManually(Number(thumb.dataset.index));
  });

  root.addEventListener('keydown', (event) => {
    if (event.key === 'ArrowLeft') stepManually(index - 1);
    else if (event.key === 'ArrowRight') stepManually(index + 1);
  });

  // 触屏上在大图上左右滑动切换
  let swipeStart: number | null = null;
  frame.addEventListener('pointerdown', (event) => {
    swipeStart = event.pointerType === 'mouse' ? null : event.clientX;
  });
  frame.addEventListener('pointerup', (event) => {
    if (swipeStart === null) return;
    const dx = event.clientX - swipeStart;
    swipeStart = null;
    if (Math.abs(dx) > 48) stepManually(index + (dx < 0 ? 1 : -1));
  });

  const setPaused = (value: boolean) => {
    paused = value;
    restartTimer();
  };
  root.addEventListener('pointerenter', () => setPaused(true));
  root.addEventListener('pointerleave', () => setPaused(root.contains(document.activeElement)));
  root.addEventListener('focusin', () => setPaused(true));
  root.addEventListener('focusout', (event) => setPaused(root.contains(event.relatedTarget as Node)));

  new IntersectionObserver(([entry]) => {
    inView = entry.isIntersecting;
    restartTimer();
  }).observe(root);
</script>

<style>
  .head {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 16px 30px;
    margin-bottom: clamp(32px, 4vw, 46px);
  }

  .head :global(.heading) {
    margin-bottom: 0;
  }

  .hint {
    display: flex;
    align-items: baseline;
    gap: 16px;
  }

  .hint-text {
    font-size: 17px;
  }

  .hint-count {
    font-family: var(--font-label);
    font-size: var(--text-small);
    letter-spacing: 1px;
    color: var(--color-accent-text);
  }

  .stage {
    --progress: 5%;
    position: relative;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    border: 1px solid color-mix(in srgb, var(--color-accent) 25%, transparent);
    background: var(--color-bg-sunken);
    clip-path: var(--clip-corner-lg);
  }

  .frame {
    position: absolute;
    inset: 0;
  }

  .frame img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .shade {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      180deg,
      color-mix(in srgb, var(--color-bg) 45%, transparent),
      transparent 28% 70%,
      color-mix(in srgb, var(--color-bg) 55%, transparent)
    );
    pointer-events: none;
  }

  .number {
    position: absolute;
    top: 26px;
    left: 32px;
    display: flex;
    align-items: baseline;
    gap: 10px;
    font-family: var(--font-label);
    pointer-events: none;
  }

  .number [data-counter] {
    font-size: clamp(40px, 5vw, 66px);
    font-weight: 700;
    line-height: 0.8;
    color: transparent;
    -webkit-text-stroke: 1.5px color-mix(in srgb, var(--color-accent) 90%, transparent);
  }

  .total {
    font-size: 18px;
    color: var(--color-accent);
  }

  .side-label {
    position: absolute;
    top: 30px;
    right: 30px;
    font-family: var(--font-label);
    font-size: var(--text-label);
    letter-spacing: 4px;
    text-transform: uppercase;
    color: var(--color-accent);
    writing-mode: vertical-rl;
    pointer-events: none;
  }

  .arrow {
    position: absolute;
    top: 50%;
    display: grid;
    place-items: center;
    width: 52px;
    height: 52px;
    border: 1px solid color-mix(in srgb, var(--color-accent) 45%, transparent);
    background: color-mix(in srgb, var(--color-bg) 70%, transparent);
    color: var(--color-accent);
    font-size: 22px;
    translate: 0 -50%;
    clip-path: var(--clip-notch-sm);
    transition:
      background-color var(--duration-hover),
      color var(--duration-hover);
  }

  .arrow:hover {
    background: var(--color-accent);
    color: var(--color-on-accent);
  }

  .previous {
    left: 22px;
  }

  .next {
    right: 22px;
  }

  .open {
    position: absolute;
    right: 30px;
    bottom: 26px;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 10px 20px;
    border: 1px solid color-mix(in srgb, var(--color-accent) 45%, transparent);
    background: color-mix(in srgb, var(--color-bg) 72%, transparent);
    font-family: var(--font-label);
    font-size: var(--text-label);
    letter-spacing: 1px;
    text-transform: uppercase;
    color: var(--color-accent);
    clip-path: var(--clip-notch-sm);
    transition:
      background-color var(--duration-hover),
      color var(--duration-hover);
  }

  .frame:hover .open {
    background: var(--color-accent);
    color: var(--color-on-accent);
  }

  .progress {
    position: absolute;
    bottom: 0;
    left: 0;
    width: var(--progress);
    height: 3px;
    background: var(--color-accent);
    transition: width 0.5s var(--ease-out);
    pointer-events: none;
  }

  .rail {
    display: flex;
    gap: 10px;
    padding: 16px 0 4px;
    overflow-x: auto;
    scrollbar-width: thin;
  }

  .thumb {
    flex: none;
    width: 104px;
    height: 62px;
    overflow: hidden;
    border: 2px solid var(--color-line-strong);
    background: var(--color-surface);
    opacity: 0.45;
    transition:
      opacity var(--duration-hover),
      border-color var(--duration-hover);
  }

  .thumb:hover {
    opacity: 0.8;
  }

  .thumb[aria-current] {
    border-color: var(--color-accent);
    opacity: 1;
  }

  .thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  @media (max-width: 600px) {
    .hint-text {
      display: none;
    }

    .number {
      top: 16px;
      left: 18px;
    }

    .side-label,
    .open {
      display: none;
    }

    .arrow {
      width: 40px;
      height: 40px;
      font-size: 18px;
    }

    .previous {
      left: 10px;
    }

    .next {
      right: 10px;
    }

    .thumb {
      width: 84px;
      height: 50px;
    }
  }
</style>

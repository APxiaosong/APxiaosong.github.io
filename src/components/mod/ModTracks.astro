---
/** 模组页的金底特性聚焦：履带系统的简介和三种运行模式。 */
import { libraryCategoryPath } from '@/components/learn/library';
import ArrowLink from '@/components/ui/ArrowLink.astro';
import Eyebrow from '@/components/ui/Eyebrow.astro';
import Section from '@/components/ui/Section.astro';
import Watermark from '@/components/ui/Watermark.astro';
import { getMod } from '@/data/mod';
import { getLang, translator } from '@/i18n';

const lang = getLang(Astro.url);
const t = translator(lang);
const { version } = getMod();

const copy = {
  eyebrow: { zh: '特性聚焦 / Feature', en: 'Feature' },
  // 英文标题即为 Track System，英文页面不显示这条注释
  eyebrowNote: { zh: 'Track System', en: '' },
  title: { zh: '履带系统', en: 'Track System' },
  description: {
    zh: '基于代码的动态履带渲染与物理模拟系统，可以识别轮组结构并自动生成履带，模式、外观、尺寸、间距和颜色都可以自定义。履带生成算法已接近生产可用。',
    en: 'A script-based system for dynamic track rendering and physics simulation. It recognizes wheel arrangements and generates tracks automatically, with mode, appearance, size, spacing and color all adjustable. The track generation algorithm is approaching production quality.',
  },
  default: { zh: '默认', en: 'Default' },
  usage: {
    zh: '将同侧的轮子按顺序连线成闭环，再放置履带控制器并连接到其中任一轮子，即可生成履带；控制器需要放在主车体上。完整的使用说明见物品描述和教程。',
    en: 'Wire the wheels on one side into a closed loop, then wire a Track Controller to any wheel in the loop to generate the track. Keep the controller on the main body of the vehicle. The item descriptions and tutorials cover the details.',
  },
  tutorials: { zh: '履带教程', en: 'Track tutorials' },
};

const modes = [
  {
    name: { zh: '简单', en: 'Simple' },
    text: {
      zh: '只计算轮组外轮廓，不与地形互动。开销最低，适合超大载具、装饰或配置较低的电脑。',
      en: 'Computes only the outer contour of the wheel set, with no terrain interaction. The lightest option, suited to oversized vehicles, decorations and low-end PCs.',
    },
  },
  {
    name: { zh: '标准', en: 'Standard' },
    text: {
      zh: '近似模拟履带在地形上的动态，兼顾观感与性能，适合多数载具。',
      en: 'Approximates how tracks move over terrain, balancing visuals and performance. Suitable for most vehicles.',
    },
    isDefault: true,
  },
  {
    name: { zh: '拟真', en: 'Realistic' },
    text: {
      zh: '真正的物理模拟履带，具备重力、惯性、断链等效果，性能开销接近标准模式。',
      en: 'Fully physics-simulated tracks with gravity, inertia and link breakage, at a performance cost close to Standard mode.',
    },
  },
];
---

<Section tone="accent" space="md" class="tracks">
  <Watermark text={version} position="bottom-left" />
  <div class="content" data-reveal>
    <Eyebrow label={t(copy.eyebrow)} note={t(copy.eyebrowNote)} />
    <h2 class="title">{t(copy.title)}</h2>
    <p class="description">{t(copy.description)}</p>

    <ol class="modes">
      {
        modes.map((mode, i) => (
          <li class="mode">
            <p class="index">
              {String(i + 1).padStart(2, '0')}
              {mode.isDefault && <span class="default">{t(copy.default)}</span>}
            </p>
            <h3 class="name">{t(mode.name)}</h3>
            <p class="text">{t(mode.text)}</p>
          </li>
        ))
      }
    </ol>

    <div class="usage">
      <p>{t(copy.usage)}</p>
      <ArrowLink href={libraryCategoryPath('track', lang)}>{t(copy.tutorials)}</ArrowLink>
    </div>
  </div>
</Section>

<style>
  .tracks {
    overflow: hidden;
  }

  .content {
    position: relative;
  }

  .title {
    margin-top: 14px;
    font-size: clamp(36px, 5.5vw, 82px);
    font-weight: 900;
    line-height: 0.95;
    letter-spacing: -1px;
  }

  .description {
    max-width: 680px;
    margin-top: 18px;
    font-size: var(--text-body);
    font-weight: 500;
    line-height: 1.9;
  }

  /* 1px 的间隙露出底色，形成格子之间的分隔线 */
  .modes {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1px;
    margin-top: 44px;
    border: 1px solid var(--color-line);
    background: var(--color-line);
  }

  .mode {
    padding: 34px 28px;
    background: var(--color-accent);
  }

  .index {
    display: flex;
    align-items: baseline;
    gap: 8px;
    font-family: var(--font-label);
    font-size: 30px;
    font-weight: 700;
    line-height: 1.2;
  }

  .default {
    padding: 2px 8px;
    border: 1px solid var(--color-line-strong);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 1px;
    text-transform: uppercase;
  }

  .name {
    margin: 8px 0 10px;
    font-size: 22px;
    font-weight: 900;
  }

  .text {
    font-size: var(--text-small);
    line-height: 1.75;
    color: var(--color-text-muted);
  }

  .usage {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 10px 24px;
    margin-top: 22px;
    font-size: var(--text-small);
    line-height: 1.8;
    color: var(--color-text-muted);
  }

  .usage p {
    max-width: 820px;
  }

  @media (max-width: 900px) {
    .modes {
      grid-template-columns: minmax(0, 1fr);
    }

    .mode {
      padding: 26px 24px;
    }
  }
</style>

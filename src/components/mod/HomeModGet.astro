---
/** 首页「获取模组」横条，锚点 #mod-get。 */
import Button from '@/components/ui/Button.astro';
import CtaBand from '@/components/ui/CtaBand.astro';
import { links } from '@/config/site';
import { getLang, translator } from '@/i18n';
import { ui } from '@/i18n/ui';

const t = translator(getLang(Astro.url));

const copy = {
  title: { zh: '在 Steam 创意工坊一键订阅', en: 'One-click subscribe on the Steam Workshop' },
  action: { zh: '前往订阅页', en: 'Open Workshop Page' },
};
---

<CtaBand id="mod-get" tag={t(ui.tag.get)} title={t(copy.title)} space="sm">
  <Button href={links.modWorkshop} variant="outline" external>{t(copy.action)}</Button>
</CtaBand>

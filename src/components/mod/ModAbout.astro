---
/**
 * 模组页「模组简介」区块：海报式标题和简介，右侧是当前版本与订阅入口，
 * 下方是新旧版本不能同时启用的提示和零件类别。版本号与更新日期来自模组数据。
 */
import ArrowLink from '@/components/ui/ArrowLink.astro';
import Button from '@/components/ui/Button.astro';
import Notice from '@/components/ui/Notice.astro';
import Tag from '@/components/ui/Tag.astro';
import Watermark from '@/components/ui/Watermark.astro';
import { links, pages } from '@/config/site';
import { getMod } from '@/data/mod';
import { getLang, localizePath, translator } from '@/i18n';
import { formatDate } from '@/i18n/format';
import { ui } from '@/i18n/ui';
import ModCategories from './ModCategories.astro';

const lang = getLang(Astro.url);
const t = translator(lang);
const mod = getMod();

const copy = {
  tag: { zh: '模组简介 / About the Mod', en: 'About the Mod' },
  title: { zh: '综合性建造模组', en: 'A comprehensive building Mod' },
  description: {
    zh: '由中国玩家团队「传奇建造队」制作的综合性建造 Mod，涵盖实用工具、材质方块、几何体、可互动零件、车辆零件、武器、装饰与建筑零件，可满足绝大部分日常建造需求。本作为 New Legend Mod 的续作版本，原 Mod 蓝图可直接打开使用，目前处于积极开发阶段，欢迎反馈漏洞。已支持中英文物品描述。',
    en: 'Made by Legend Build Team, a Chinese player community, this comprehensive building Mod includes utility tools, material blocks, geometric shapes, interactive parts, vehicle components, weapons, decorations and building elements, covering most everyday building needs. It continues the original New Legend Mod, and blueprints made with the original open directly. The Mod is under active development, and bug reports are welcome. Item descriptions are available in Chinese and English.',
  },
  version: { zh: '当前版本 / Version', en: 'Current Version' },
  changelog: { zh: '详细更新列表', en: 'Full changelog' },
  updated: { zh: `更新于 ${formatDate(mod.updatedAt, 'zh')}`, en: `Updated ${formatDate(mod.updatedAt, 'en')}` },
  conflict: {
    zh: `请勿同时启用 New Legend Mod 3.2.3 与 Continuation ${mod.version}，二者只能择一启用，否则会引发未知错误。`,
    en: `Do not enable New Legend Mod 3.2.3 and New Legend Mod Continuation ${mod.version} at the same time. Only one can be active; otherwise unexpected errors will occur.`,
  },
};
---

<section class="about">
  <div class="poster">
    <Watermark text="NLM" class="watermark" />
    <div class="container" data-reveal>
      <Tag dot>{t(copy.tag)}</Tag>
      <div class="columns">
        <div>
          <h2 class="title">{t(copy.title)}</h2>
          <p class="subtitle text-accent">New Legend Mod · Continuation</p>
          <p class="text-body description">{t(copy.description)}</p>
        </div>
        <div class="panel">
          <p class="text-label panel-label">{t(copy.version)}</p>
          <p class="version">{mod.version}</p>
          <ArrowLink href={localizePath(pages.news, lang)} underline class="changelog">{t(copy.changelog)}</ArrowLink>
          <Button href={links.modWorkshop} external class="subscribe">{t(ui.mod.subscribe)}</Button>
          <p class="text-label updated">{t(copy.updated)}</p>
        </div>
      </div>
      <Notice class="notice">{t(copy.conflict)}</Notice>
    </div>
  </div>

  <div class="container categories" data-reveal>
    <ModCategories />
  </div>
</section>

<style>
  .about {
    --color-surface: var(--color-bg);
    border-top: 1px solid var(--color-line);
    background: var(--color-bg-alt);
  }

  .poster {
    position: relative;
    overflow: hidden;
    padding-block: var(--space-section-lg) clamp(48px, 5vw, 70px);
    border-bottom: 1px solid var(--color-line);
  }

  .poster :global(.watermark) {
    top: -8%;
    right: -2%;
    font-size: clamp(150px, 24vw, 420px);
    line-height: 0.7;
    letter-spacing: -6px;
  }

  .poster .container {
    position: relative;
  }

  .columns {
    display: grid;
    grid-template-columns: 1.4fr 1fr;
    gap: 56px;
    align-items: end;
    margin-top: 26px;
  }

  .title {
    font-size: clamp(44px, 6.5vw, 104px);
    font-weight: 900;
    line-height: 0.92;
    letter-spacing: -1px;
  }

  .title:lang(en) {
    font-size: clamp(40px, 5.6vw, 84px);
    line-height: 1;
  }

  .subtitle {
    margin-top: 8px;
    font-size: var(--text-subtitle);
  }

  .description {
    max-width: 620px;
    margin-top: 24px;
  }

  .panel {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 14px;
    padding-left: 32px;
    border-left: 1px solid var(--color-line);
  }

  .panel-label,
  .updated {
    color: var(--color-text-muted);
  }

  .version {
    font-family: var(--font-label);
    font-size: clamp(40px, 5vw, 68px);
    font-weight: 700;
    line-height: 1;
    color: var(--color-accent-text);
  }

  .panel :global(.subscribe) {
    align-self: stretch;
    margin-top: 8px;
  }

  .updated {
    display: inline-flex;
    align-items: center;
    gap: 9px;
  }

  .updated::before {
    content: '';
    width: 7px;
    height: 7px;
    background: var(--color-accent);
  }

  .poster :global(.notice) {
    margin-top: 44px;
  }

  .categories {
    padding-block: var(--space-section-sm);
  }

  @media (max-width: 900px) {
    .columns {
      grid-template-columns: minmax(0, 1fr);
      gap: 36px;
    }

    .panel {
      padding: 28px 0 0;
      border-top: 1px solid var(--color-line);
      border-left: 0;
    }
  }
</style>

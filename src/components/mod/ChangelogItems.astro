---
/** 更新记录中的条目列表。带有子条目的条目递归输出下一级列表，下一级使用空心方块。 */
import type { ChangelogItem } from '@/data/changelog';
import { getLang, translator } from '@/i18n';

interface Props {
  items: ChangelogItem[];
  nested?: boolean;
}

const { items, nested = false } = Astro.props;
const t = translator(getLang(Astro.url));
---

<ul class:list={['items', { nested }]}>
  {
    items.map((item) => (
      <li>
        {t(item.text)}
        {item.items && <Astro.self items={item.items} nested />}
      </li>
    ))
  }
</ul>

<style>
  .items {
    display: flex;
    flex-direction: column;
    gap: 9px;
  }

  .nested {
    gap: 6px;
    margin-top: 8px;
  }

  li {
    position: relative;
    padding-left: 18px;
    font-size: var(--text-small);
    font-weight: 300;
    line-height: 1.7;
    color: var(--color-text-secondary);
  }

  li::before {
    content: '';
    position: absolute;
    top: 9px;
    left: 0;
    width: 5px;
    height: 5px;
    background: var(--color-accent);
  }

  .nested > li::before {
    border: 1px solid var(--color-accent);
    background: none;
  }
</style>

---
/**
 * 全站页面骨架：<head> 元信息、主题初始化、导航、页脚和滚动入场动画。
 * title 为页面名称，自动加上站点名；首页不传 title，只显示站点名。
 * image 为分享卡片使用的图片，不传时使用模组封面。
 * noindex 用于 404 等不需要被搜索引擎收录的页面，同时省略 canonical 和语言互链。
 * 这类页面没有另一种语言版本，语言切换指向另一种语言的首页，也不按访客的语言偏好跳转。
 */
import type { ImageMetadata } from 'astro';
import { getImage } from 'astro:assets';
import '@/styles/fonts.css';
import '@/styles/tokens.css';
import '@/styles/global.css';
import defaultShareImage from '@/assets/images/mod-cover.jpg';
import favicon from '@/assets/images/logo-stacked.png';
import Footer from '@/components/layout/Footer.astro';
import Nav from '@/components/layout/Nav.astro';
import { alternatePath, getLang, hreflangLinks, htmlLang, ogLocale, otherLang, pageKey, pagePath, translator } from '@/i18n';
import { ui } from '@/i18n/ui';

interface Props {
  title?: string;
  description?: string;
  image?: ImageMetadata;
  noindex?: boolean;
}

const { title, description, image = defaultShareImage, noindex = false } = Astro.props;
const lang = getLang(Astro.url);
const t = translator(lang);
const siteName = t(ui.site.name);
const fullTitle = title ? `${title} | ${siteName}` : siteName;
const pageDescription = description ?? t(ui.site.description);
const absolute = (path: string) => new URL(path, Astro.site).href;
const canonical = absolute(pagePath(Astro.url));
const alternate = noindex ? null : alternatePath(Astro.url);
const redirect = alternate ? { lang: htmlLang[otherLang(lang)], path: alternate } : null;

const [shareImage, icon, touchIcon] = await Promise.all([
  getImage({ src: image, width: 1200, height: 630, fit: 'cover', format: 'jpg' }),
  getImage({ src: favicon, width: 64, height: 64, fit: 'contain', format: 'png' }),
  getImage({ src: favicon, width: 180, height: 180, fit: 'contain', format: 'png' }),
]);
---

<!doctype html>
<html lang={htmlLang[lang]} data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#0f0e0b" />
    <title>{fullTitle}</title>
    <meta name="description" content={pageDescription} />
    {
      noindex ? (
        <meta name="robots" content="noindex" />
      ) : (
        <>
          <link rel="canonical" href={canonical} />
          {hreflangLinks(pageKey(Astro.url)).map(({ hreflang, path }) => (
            <link rel="alternate" hreflang={hreflang} href={absolute(path)} />
          ))}
        </>
      )
    }
    <link rel="icon" type="image/png" href={icon.src} />
    <link rel="apple-touch-icon" href={touchIcon.src} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={absolute(shareImage.src)} />
    <meta property="og:locale" content={ogLocale[lang]} />
    <meta name="twitter:card" content="summary_large_image" />

    {/* 在首次绘制前：访客保存的语言偏好（lang 键）是另一种语言时，跳到那种语言的同一页面；
        应用保存的主题，默认深色；标记脚本可用，入场动画据此生效 */}
    <script is:inline define:vars={{ redirect }}>
      /* define:vars 让 Astro 把脚本包进一个函数，这里的变量不会进入全局 */
      const root = document.documentElement;
      root.classList.add('js');
      try {
        if (redirect && localStorage.getItem('lang') === redirect.lang) {
          location.replace(redirect.path + location.search + location.hash);
        }
        if (localStorage.getItem('theme') === 'light') {
          root.dataset.theme = 'light';
          document.querySelector('meta[name="theme-color"]').content = '#f7f5f0';
        }
      } catch {}
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">{t(ui.common.skipToContent)}</a>
    <Nav alternate={alternate} />
    <main id="main">
      <slot />
    </main>
    <Footer />
  </body>
</html>

<script>
  import { anchorTarget } from '@/components/ui/anchor';

  const revealed = new IntersectionObserver(
    (entries) => {
      for (const entry of entries) {
        if (!entry.isIntersecting) continue;
        entry.target.classList.add('is-revealed');
        revealed.unobserve(entry.target);
      }
    },
    { threshold: 0.1, rootMargin: '0px 0px -8% 0px' },
  );

  document.querySelectorAll('[data-reveal]').forEach((element) => revealed.observe(element));

  // 带锚点打开时先直接定位到目标，再启用平滑滚动，页面不会从顶部滑下去
  addEventListener('load', () => {
    anchorTarget()?.scrollIntoView({ behavior: 'instant' });
    document.documentElement.classList.add('is-loaded');
  });
</script>

<style>
  .skip-link {
    position: fixed;
    top: 12px;
    left: 12px;
    z-index: 300;
    padding: 10px 18px;
    background: var(--color-accent);
    color: var(--color-on-accent);
    font-weight: 700;
    translate: 0 -200%;
    transition: translate var(--duration-hover) var(--ease-out);
  }

  .skip-link:focus {
    translate: 0 0;
  }
</style>

---
/** 获取页：主推的传奇模组、相关物品与社区入口、安装步骤，以及更新后刷新游戏的方法。 */
import { Image } from 'astro:assets';
import cover from '@/assets/images/legend-survival-cover.jpg';
import modCover from '@/assets/images/mod-cover.jpg';
import RelatedMods from '@/components/mod/RelatedMods.astro';
import ArrowLink from '@/components/ui/ArrowLink.astro';
import Badge from '@/components/ui/Badge.astro';
import Button from '@/components/ui/Button.astro';
import ButtonGroup from '@/components/ui/ButtonGroup.astro';
import Card from '@/components/ui/Card.astro';
import Eyebrow from '@/components/ui/Eyebrow.astro';
import NumberedIntro from '@/components/ui/NumberedIntro.astro';
import PageHero from '@/components/ui/PageHero.astro';
import Section from '@/components/ui/Section.astro';
import Tag from '@/components/ui/Tag.astro';
import { links, pages } from '@/config/site';
import { getMod } from '@/data/mod';
import { getLang, getLangPaths, localizePath, translator } from '@/i18n';
import { formatDate } from '@/i18n/format';
import BaseLayout from '@/layouts/BaseLayout.astro';

export const getStaticPaths = getLangPaths;

const lang = getLang(Astro.url);
const t = translator(lang);
const mod = getMod();

const copy = {
  title: { zh: '获取中心', en: 'Get the Mod' },
  tag: { zh: '获取 / Get', en: 'Get' },
  lead: {
    zh: '在这里集中获取传奇建造队制作的模组与自定义游戏。所有内容都通过 Steam 创意工坊分发，订阅后自动下载并保持更新。',
    en: 'Mods and custom games from Legend Build Team, all in one place. Everything is distributed through the Steam Workshop and stays up to date once you subscribe.',
  },
  featured: { zh: '01 · 主推内容', en: '01 · Featured' },
  featuredNote: { zh: 'Featured', en: '' },
  modBadge: { zh: 'Mod · 模组', en: 'Mod' },
  modName: { zh: '传奇模组', en: 'New Legend Mod' },
  modSubtitle: { zh: 'New Legend Mod', en: 'Continuation' },
  modText: {
    zh: '综合性建造 Mod，涵盖材质方块、几何体、可互动零件、载具、武器、装饰与传奇专属零件。现已支持英文物品描述。',
    en: 'A comprehensive building Mod with material blocks, geometric shapes, interactive parts, vehicles, weapons, decorations and parts unique to the Mod. Item descriptions are available in English.',
  },
  version: { zh: '版本', en: 'Version' },
  size: { zh: '大小', en: 'Size' },
  updated: { zh: '更新', en: 'Updated' },
  subscribe: { zh: '订阅模组', en: 'Subscribe' },
  details: { zh: '模组详情', en: 'About the Mod' },
  more: { zh: '02 · 更多模组', en: '02 · More' },
  steamGroup: { zh: 'Steam 社区组', en: 'Steam Group' },
  steamGroupText: {
    zh: '加入官方社区组，获取动态、活动与第一手发布信息。',
    en: 'Join the official group for news, events and release announcements.',
  },
  join: { zh: '加入', en: 'Join' },
  game: { zh: '废品机械师', en: 'Scrap Mechanic' },
  gameText: {
    zh: '所有内容运行的本体游戏，在 Steam 商店了解与购买。',
    en: 'The base game everything here runs on. Learn more and buy it on the Steam Store.',
  },
  view: { zh: '查看', en: 'View' },
  howToTag: { zh: '如何安装 / How to', en: 'How to Install' },
  howToTitle: { zh: '三步开始你的建造', en: 'Start building in three steps' },
  refreshEyebrow: { zh: '更新之后 / After Updating', en: 'After Updating' },
  refreshTitle: { zh: '更新后需要刷新一次游戏', en: 'Refresh the game once after an update' },
  refreshText: {
    zh: '受游戏缓存的影响，模组更新后，一部分内容在你的电脑上可能仍是旧版本，例如看不到履带或零件显示异常。用开发者模式启动一次游戏，就能把它们全部刷新过来。',
    en: 'Because of the game’s caching, some Mod content on your computer may stay on the old version after an update; tracks may not show, for example, or parts may look broken. Launching the game once in developer mode refreshes all of it.',
  },
  refreshNote: {
    zh: '删掉之后就可以照常和其他玩家联机了。',
    en: 'After removing it, you can play multiplayer with others as usual.',
  },
};

const specs = [
  { label: copy.version, value: mod.version },
  { label: copy.size, value: `${mod.fileSizeMb.toFixed(1)} MB` },
  { label: copy.updated, value: formatDate(mod.updatedAt, lang) },
];

const installSteps = [
  { zh: '在 Steam 拥有并安装《废品机械师》。', en: 'Own and install Scrap Mechanic on Steam.' },
  {
    zh: '在创意工坊页面点击「订阅」，等待自动下载。',
    en: 'Click Subscribe on the Workshop page and wait for the download to finish.',
  },
  {
    zh: '进入游戏，新建存档时勾选传奇模组，或在已有存档的模组管理中启用。',
    en: 'Launch the game and tick the Mod when creating a world, or enable it in an existing world’s mod settings.',
  },
];

const LAUNCH_OPTION = '-dev';

const refreshSteps = [
  { zh: '退出游戏', en: 'Exit the game' },
  {
    zh: '在 Steam 库中右键《废品机械师》，选择“属性”',
    en: 'In your Steam library, right-click Scrap Mechanic and select “Properties”',
  },
  {
    zh: `打开“通用”页，在“启动选项”里填入 ${LAUNCH_OPTION}`,
    en: `Open the “General” tab and enter ${LAUNCH_OPTION} under “Launch Options”`,
  },
  { zh: '启动游戏，进入一次装有传奇模组的存档', en: 'Launch the game and load a save that uses the Mod once' },
  {
    zh: `退出游戏，把“启动选项”里的 ${LAUNCH_OPTION} 删掉`,
    en: `Exit the game and remove ${LAUNCH_OPTION} from “Launch Options”`,
  },
];

// 把步骤文字按启动参数拆开，参数单独以代码样式显示
const splitLaunchOption = (text: string) => text.split(new RegExp(`(${LAUNCH_OPTION})`));
---

<BaseLayout title={t(copy.title)} description={t(copy.lead)} image={cover}>
  <PageHero
    image={cover}
    tag={t(copy.tag)}
    title={t(copy.title)}
    subtitle="Mods & Setup"
    lead={t(copy.lead)}
    watermark="GET"
  />

  <Section>
    <Eyebrow label={t(copy.featured)} note={t(copy.featuredNote)} class="group-label" data-reveal />
    <article class="featured" data-reveal>
      <div class="featured-media">
        <Image src={modCover} alt="" widths={[640, 960, 1280]} sizes="(max-width: 1100px) 100vw, 760px" />
        <Badge class="featured-badge">{t(copy.modBadge)}</Badge>
      </div>
      <div class="featured-body">
        <h2 class="featured-title">{t(copy.modName)}</h2>
        <p class="featured-subtitle text-accent">{t(copy.modSubtitle)}</p>
        <p class="text-body featured-text">{t(copy.modText)}</p>
        <dl class="specs">
          {
            specs.map((spec) => (
              <div>
                <dt class="text-label">{t(spec.label)}</dt>
                <dd>{spec.value}</dd>
              </div>
            ))
          }
        </dl>
        <ButtonGroup class="actions">
          <Button href={links.modWorkshop} external>{t(copy.subscribe)}</Button>
          <Button href={localizePath(pages.mod, lang)} variant="ghost">{t(copy.details)}</Button>
        </ButtonGroup>
      </div>
    </article>

    <Eyebrow label={t(copy.more)} note="Related Mods & Custom Games" class="group-label more" data-reveal />
    <div data-reveal>
      <RelatedMods />
    </div>
    <div class="channels" data-reveal>
      <Card href={links.steamGroup} external shape="notch">
        <p class="text-label channel-label">Steam</p>
        <h3 class="channel-title">{t(copy.steamGroup)}</h3>
        <p class="channel-text">{t(copy.steamGroupText)}</p>
        <ArrowLink external class="channel-action">{t(copy.join)}</ArrowLink>
      </Card>
      <Card href={links.gameStore} external shape="notch">
        <p class="text-label channel-label">Steam</p>
        <h3 class="channel-title">{t(copy.game)}</h3>
        <p class="channel-text">{t(copy.gameText)}</p>
        <ArrowLink external class="channel-action">{t(copy.view)}</ArrowLink>
      </Card>
    </div>
  </Section>

  <Section divider>
    <NumberedIntro index="03" data-reveal>
      <Tag>{t(copy.howToTag)}</Tag>
      <h2 class="how-to-title">{t(copy.howToTitle)}</h2>
      <ol class="steps">
        {
          installSteps.map((step, i) => (
            <li>
              <Card shape="notch" class="step">
                <p class="step-index">{String(i + 1).padStart(2, '0')}</p>
                <p class="step-text">{t(step)}</p>
              </Card>
            </li>
          ))
        }
      </ol>

      <div class="refresh">
        <div>
          <Eyebrow label={t(copy.refreshEyebrow)} />
          <h3 class="refresh-title">{t(copy.refreshTitle)}</h3>
          <p class="refresh-text">{t(copy.refreshText)}</p>
        </div>
        <div>
          <ol class="refresh-steps">
            {
              refreshSteps.map((step) => (
                <li>
                  {splitLaunchOption(t(step)).map((part) =>
                    part === LAUNCH_OPTION ? <code>{part}</code> : part,
                  )}
                </li>
              ))
            }
          </ol>
          <p class="refresh-note">{t(copy.refreshNote)}</p>
        </div>
      </div>
    </NumberedIntro>
  </Section>
</BaseLayout>

<style>
  .group-label {
    margin-bottom: 44px;
  }

  .group-label.more {
    margin-top: var(--space-section-md);
  }

  .featured {
    display: grid;
    grid-template-columns: 1.15fr 1fr;
    border: 1px solid color-mix(in srgb, var(--color-accent) 25%, transparent);
    clip-path: var(--clip-corner-lg);
  }

  .featured-media {
    position: relative;
    min-height: 340px;
    overflow: hidden;
  }

  .featured-media :global(img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .featured-media :global(.featured-badge) {
    position: absolute;
    top: 0;
    left: 0;
    padding: 7px 14px;
    letter-spacing: 2px;
  }

  .featured-body {
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: clamp(32px, 4vw, 48px);
  }

  .featured-title {
    font-size: clamp(30px, 3.6vw, 46px);
    font-weight: 900;
    line-height: 1.05;
  }

  .featured-subtitle {
    margin-top: 4px;
    font-size: 22px;
  }

  .featured-text {
    margin-top: 20px;
    font-size: 15px;
    line-height: 2;
  }

  .specs {
    display: flex;
    flex-wrap: wrap;
    gap: 14px 36px;
    margin-top: 24px;
  }

  .specs dt {
    color: var(--color-text-muted);
  }

  .specs dd {
    margin-top: 4px;
    font-family: var(--font-label);
    font-size: 16px;
    letter-spacing: 1px;
  }

  .actions {
    gap: 12px;
    margin-top: 30px;
  }

  .channels {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 16px;
    margin-top: 16px;
  }

  .channel-label {
    color: var(--color-accent-text);
  }

  .channel-title {
    margin: 12px 0 10px;
    font-size: 22px;
    font-weight: 700;
  }

  .channel-text {
    font-size: var(--text-small);
    font-weight: 300;
    line-height: 1.8;
    color: var(--color-text-muted);
  }

  .channels :global(.channel-action) {
    margin-top: 20px;
  }

  .how-to-title {
    margin: 18px 0 36px;
    font-size: clamp(28px, 3.8vw, 46px);
    font-weight: 900;
  }

  .steps {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 16px;
  }

  .steps :global(.step) {
    height: 100%;
  }

  .step-index {
    font-family: var(--font-label);
    font-size: 30px;
    font-weight: 700;
    line-height: 1.2;
    color: var(--color-accent-text);
  }

  .step-text {
    margin-top: 14px;
    font-size: 15px;
    line-height: 1.85;
    color: var(--color-text-secondary);
  }

  .refresh {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
    gap: 24px 56px;
    margin-top: 16px;
    padding: clamp(28px, 3.5vw, 44px);
    border: 1px solid var(--color-accent-line);
    background: var(--color-accent-tint);
    clip-path: var(--clip-notch-lg);
  }

  .refresh-title {
    margin-top: 12px;
    font-size: 22px;
    font-weight: 700;
    line-height: 1.4;
  }

  .refresh-text {
    margin-top: 12px;
    font-size: var(--text-small);
    font-weight: 300;
    line-height: 1.85;
    color: var(--color-text-secondary);
  }

  .refresh-steps {
    display: flex;
    flex-direction: column;
    gap: 12px;
    counter-reset: refresh-step;
  }

  .refresh-steps li {
    position: relative;
    padding-left: 40px;
    font-size: 15px;
    line-height: 1.7;
    color: var(--color-text-secondary);
    counter-increment: refresh-step;
  }

  .refresh-steps li::before {
    content: counter(refresh-step, decimal-leading-zero);
    position: absolute;
    left: 0;
    font-family: var(--font-label);
    font-weight: 600;
    color: var(--color-accent-text);
  }

  code {
    padding: 1px 8px;
    border: 1px solid var(--color-accent-line);
    font-family: var(--font-label);
    font-size: 0.95em;
    letter-spacing: 1px;
    white-space: nowrap;
    color: var(--color-accent-text);
  }

  .refresh-note {
    margin-top: 16px;
    padding-left: 40px;
    font-size: var(--text-small);
    color: var(--color-text-muted);
  }

  /* 封面图自带文字，双栏变窄后裁切过多，所以在收窄断点就改为上下排列 */
  @media (max-width: 1100px) {
    .refresh,
    .featured {
      grid-template-columns: minmax(0, 1fr);
    }

    .featured-media {
      min-height: 0;
      aspect-ratio: 16 / 9;
    }
  }

  @media (max-width: 900px) {
    .steps {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  @media (max-width: 600px) {
    .channels {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
